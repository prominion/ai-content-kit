{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "HYPERFRAMES_SKIP_SKILLS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npm run brand)",
      "Bash(npm run brand *)",
      "Bash(npm run reference)",
      "Bash(npm run works)",
      "Bash(npm run new *)",
      "Bash(npm run check *)",
      "Bash(npm run reference *)",
      "Bash(npm run dev *)",
      "Bash(npm run render *)",
      "Bash(npx --yes hyperframes@0.8.144 *)",
      "Bash(npx hyperframes@0.8.144 *)",
      "Bash(ffmpeg *)",
      "Bash(ffprobe *)"
    ]
  }
}
