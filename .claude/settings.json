{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "HYPERFRAMES_SKIP_SKILLS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npm run brand)",
      "Bash(npm run brand *)",
      "Bash(npm run reference)",
      "Bash(npm run works)",
      "Bash(npm run new *)",
      "Bash(npm run check *)",
      "Bash(npm run reference *)",
      "Bash(npm run dev *)",
      "Bash(npm run render *)",
      "Bash(npx --yes hyperframes@* *)",
      "Bash(npx hyperframes@* *)",
      "Bash(ffmpeg *)",
      "Bash(ffprobe *)",
      "Bash(npm run gif *)",
      "Bash(npm run shot *)",
      "Bash(npm run check)",
      "Bash(npm run render)",
      "Bash(cd * && npm run *)",
      "Bash(cd * && npx --yes hyperframes@* *)",
      "Bash(npm run transcribe *)",
      "Bash(yt-dlp *)"
    ]
  }
}
